# Required for DashScope / Alibaba Tongyi model calls
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Optional LangSmith tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=rag-langgraph-local

# Model settings
QWEN_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v4
# text-embedding-v4 supports configurable dimensions; leave blank to use DashScope default
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=10
DASHSCOPE_REQUEST_TIMEOUT=120
DASHSCOPE_MAX_RETRIES=3
# Optional: override if your DashScope account/network uses another endpoint
DASHSCOPE_HTTP_BASE_URL=

# Local Chroma vector database path
CHROMA_DIR=.chroma
COLLECTION_NAME=rag-chroma

# Source URLs, comma-separated. Leave empty to use DEFAULT_URLS from src/config.py.
SOURCE_URLS=

# Web search for automatic source discovery when no URLs are provided
WEB_SEARCH_ENABLED=true
# Search provider: duckduckgo or baidu
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_MAX_RESULTS=20
WEB_SEARCH_REGION=wt-wt
# Optional DuckDuckGo timelimit: d, w, m, or y
WEB_SEARCH_TIMELIMIT=
# Set false only if your local certificate store blocks HTTPS verification
WEB_SEARCH_VERIFY_SSL=true
