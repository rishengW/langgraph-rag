# Required for DashScope / Alibaba Tongyi model calls (always needed for embeddings)
DASHSCOPE_API_KEY=your_key_here

# Chat LLM provider: dashscope (default) or deepseek
LLM_PROVIDER=dashscope
# Required when LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-pro

# Optional LangSmith tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=only-subcribers

CHUNK_SIZE=800
CHUNK_OVERLAP=150
ALLOW_LOW_RELEVANCE_GENERATE=true
MIN_KEYWORD_MATCHES=0

# Model settings
QWEN_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v4
# text-embedding-v4 supports configurable dimensions; leave blank to use DashScope default
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=10
DASHSCOPE_REQUEST_TIMEOUT=120
DASHSCOPE_MAX_RETRIES=3
# Maximum number of times the grader is allowed to send the question back to
# the rewrite node before generation is forced. 0 disables rewrites entirely.
MAX_REWRITES=2
# Bound only the transcript projection sent to chat LLM calls. The complete
# thread remains available through the history API.
CHAT_CONTEXT_MAX_TURNS=8
CHAT_CONTEXT_MAX_CHARS=12000
# Per-URL timeout (seconds) when fetching source pages. Unreachable hosts are
# skipped after this many seconds instead of hanging the indexing run.
PAGE_LOAD_TIMEOUT=15
# Maximum number of source URLs fetched in parallel during indexing.
PAGE_LOAD_MAX_CONCURRENCY=4
# In-process source document cache TTL in seconds. 0 disables caching.
PAGE_LOAD_CACHE_TTL_SECONDS=0
# Conservative pre-index document filtering. The relevance query is optional;
# leave it empty for configured source URLs unless you intentionally want
# keyword-overlap filtering before splitting and embedding.
DOCUMENT_QUALITY_FILTER_ENABLED=true
DOCUMENT_QUALITY_MIN_TEXT_LENGTH=80
DOCUMENT_QUALITY_MIN_UNIQUE_TERMS=8
DOCUMENT_QUALITY_RELEVANCE_QUERY=
DOCUMENT_QUALITY_QUERY_MIN_OVERLAP=1
DOCUMENT_QUALITY_MIN_SIMILARITY=0.5
DOCUMENT_QUALITY_RECENCY_BIAS_DAYS=365
# Post-retrieval reranking strategy: lexical (default), embedding, or hybrid.
RERANK_STRATEGY=lexical
# Optional: override if your DashScope account/network uses another endpoint
DASHSCOPE_HTTP_BASE_URL=

# Local Chroma vector database path
CHROMA_DIR=.chroma
COLLECTION_NAME=rag-chroma

# Source URLs, comma-separated. Leave empty to use DEFAULT_URLS from src/config.py.
SOURCE_URLS=

# Web search for automatic source discovery when no URLs are provided
WEB_SEARCH_ENABLED=true
# Optional compatibility mode. Keep false to avoid an extra LLM call per search.
WEB_SEARCH_LLM_QUERY_REWRITE_ENABLED=false
# Search provider: bing, baidu, or duckduckgo
WEB_SEARCH_PROVIDER=bing
WEB_SEARCH_MAX_RESULTS=20
# Of the URLs returned by the search engine, how many of the top-ranked
# results to actually fetch and index. Lowering this keeps the answer focused
# on the most relevant pages and speeds up indexing. Set to 0 to fetch all.
WEB_SEARCH_TOP_K=6
# Minimum URL quality score before a search result is considered usable.
WEB_SEARCH_MIN_URL_SCORE=45
WEB_SEARCH_REGION=wt-wt
# For Bing, the default wt-wt is treated as zh-CN.
# Optional DuckDuckGo timelimit: d, w, m, or y
WEB_SEARCH_TIMELIMIT=
# Set false only if your local certificate store blocks HTTPS verification
WEB_SEARCH_VERIFY_SSL=true
# Use lightweight fetch -> extract -> direct prompt path for one-shot web search URLs.
# Set false to preserve the heavy Chroma retrieval/rewrite path for web search.
WEB_SEARCH_LIGHTWEIGHT=true
# Per-page token budget for lightweight web-search context.
WEB_SEARCH_MAX_PAGE_TOKENS=8000
# Minimum extracted content required before a web page is treated as readable.
WEB_SEARCH_MIN_PAGE_CHARS=200
WEB_SEARCH_MIN_PAGE_TOKENS=50
# Optional browser-backed fetch fallback for JS-rendered pages.
# Requires installing Playwright and running: python -m playwright install chromium
WEB_SEARCH_JS_FALLBACK_ENABLED=true
WEB_SEARCH_JS_FALLBACK_DOMAINS=baike.baidu.com,zhuanlan.zhihu.com,apps.microsoft.com,deepseek.net
WEB_SEARCH_JS_FORCE_DOMAINS=

# Optional agent tools. These default to false so existing deployments keep the
# original retriever/web-search tool set until each integration is enabled.
WEATHER_ENABLED=true
STOCK_ENABLED=true
CURRENCY_ENABLED=true
WIKIPEDIA_ENABLED=true
# Directions/route tool (OSRM public demo server, no API key) and map locator
# tool (Open-Meteo geocoding + OpenStreetMap links, no API key).
DIRECTIONS_ENABLED=true
MAP_ENABLED=true
# Symbolic math tool (SymPy: derivatives, integrals, solve, simplify, limits, series). No API key.
MATH_ENABLED=true
# Descriptive statistics, linear algebra, and number theory tools. No API key.
STATISTICS_ENABLED=true
LINALG_ENABLED=true
NUMBER_THEORY_ENABLED=true
# Date/time math + timezone conversion tool (stdlib). No API key.
DATETIME_ENABLED=true
# Single-URL fetch + summarize tool (reuses web-search fetcher + the LLM). No API key.
SUMMARIZE_URL_ENABLED=true
# Local file-reading tools (.txt/.md/.log/.csv, Word .docx, Excel .xlsx, PDF .pdf).
# Reads are confined to FILE_READ_ROOT and capped at FILE_READ_MAX_BYTES.
# Sensitive files (.env, keys, credentials) are always refused.
FILE_READ_ENABLED=true
FILE_READ_ROOT=.
FILE_READ_MAX_BYTES=5000000
WIKIPEDIA_MAX_SUMMARY_CHARS=1500
# Use a deployment-specific contact string for Wikimedia API etiquette.
WIKIPEDIA_USER_AGENT="langgraph-rag/1.0 (contact: configure WIKIPEDIA_USER_AGENT)"
