# Required for DashScope / Alibaba Tongyi model calls (always needed for embeddings)
DASHSCOPE_API_KEY=your_key_here

# Chat LLM provider: dashscope (default) or deepseek
LLM_PROVIDER=dashscope
# Required when LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-pro
# DeepSeek-compatible endpoint. Override only for a proxy or gateway.
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional LangSmith tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=only-subcribers

# Optional HTTP API server (src/qa/api.py). This key authenticates API callers
# with "Authorization: Bearer <API_KEY>"; it is unrelated to the DashScope and
# DeepSeek keys above. Blank disables API authentication entirely.
API_KEY=
# Bind address and port for the API server. 127.0.0.1 keeps it local-only;
# use 0.0.0.0 plus a non-blank API_KEY to expose it.
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated Origins allowed to call the API. Blank means no cross-origin
# callers, which is what you want for a local server.
CORS_ALLOW_ORIGINS=

# Deployment capability declarations. Production startup defaults to exactly one
# worker and one replica while SQLite, Chroma, uploads/artifacts, process-local
# locks, quota state, and catalog state remain authoritative. WEB_CONCURRENCY
# and UVICORN_WORKERS are also checked as worker-count aliases. There is no
# environment-only shared-state override: scaled production requires a complete
# code-provided generation whose implementations are configured and validated.
RAG_ENV=development
RAG_WORKER_COUNT=1
RAG_REPLICA_COUNT=1
# Stable identity attached by the trusted API authentication boundary. Do not
# accept caller-provided principal or tenant headers at the public edge.
API_PRINCIPAL_ID=api-key-client
API_TENANT_ID=
# Process-local rolling-minute and active-call quotas. Multi-replica deployments
# require shared quota state before these values can be used safely.
QUOTA_PRINCIPAL_REQUESTS_PER_MINUTE=120
QUOTA_TENANT_REQUESTS_PER_MINUTE=600
QUOTA_PRINCIPAL_CONCURRENT_CALLS=4
QUOTA_TENANT_CONCURRENT_CALLS=16
QUOTA_PRINCIPAL_SEARCHES_PER_MINUTE=30
QUOTA_TENANT_SEARCHES_PER_MINUTE=120
QUOTA_PRINCIPAL_TOKENS_PER_MINUTE=250000
QUOTA_TENANT_TOKENS_PER_MINUTE=1000000
QUOTA_PRINCIPAL_TOOL_CALLS_PER_MINUTE=240
QUOTA_TENANT_TOOL_CALLS_PER_MINUTE=1000
QUOTA_PRINCIPAL_RETRIES_PER_MINUTE=600
QUOTA_TENANT_RETRIES_PER_MINUTE=3000
QUOTA_PRINCIPAL_COST_UNITS_PER_MINUTE=500000
QUOTA_TENANT_COST_UNITS_PER_MINUTE=2000000
QUOTA_MAX_TRACKED_IDENTITIES=4096

# Separate stateless inbound MCP server. Disabled by default and launched only
# with: python -m src.adapters.mcp_server.main
MCP_ENABLED=false
MCP_TRANSPORT=stdio
MCP_ENVIRONMENT=development
MCP_HOST=127.0.0.1
MCP_PORT=8002
MCP_PATH=/mcp
# Anonymous HTTP is accepted only when environment=development and this flag is true.
MCP_ALLOW_ANONYMOUS_HTTP=false
# Name of the environment variable containing the transitional shared bearer key.
# API_KEY reuses the existing server-side key without copying it into MCP config.
MCP_AUTH_SECRET_ENV=API_KEY
MCP_HTTP_PRINCIPAL_ID=mcp-shared-key
# Required as HTTPS outside development when HTTP transport is selected.
MCP_PUBLIC_BASE_URL=
# Exact comma-separated Host and Origin values. Staging/production require hosts;
# wildcard hosts/origins are rejected outside development.
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
MCP_MAX_QUESTION_CHARS=16000
MCP_MAX_SOURCE_URLS=10
MCP_MAX_SEARCH_RESULTS=10
MCP_MAX_RETURNED_SOURCES=10
MCP_MAX_WARNINGS=5
MCP_MAX_ANSWER_CHARS=32000
MCP_MAX_OUTPUT_BYTES=65536
MCP_DEADLINE_SECONDS=120
MCP_SHUTDOWN_GRACE_SECONDS=10
MCP_MAX_CONCURRENCY=4
MCP_RATE_LIMIT_PER_MINUTE=30
MCP_MAX_REQUEST_BODY_BYTES=65536

CHUNK_SIZE=800
CHUNK_OVERLAP=150
ALLOW_LOW_RELEVANCE_GENERATE=true
MIN_KEYWORD_MATCHES=0

# Model settings
QWEN_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v4
# text-embedding-v4 supports configurable dimensions; leave blank to use DashScope default
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=10
DASHSCOPE_REQUEST_TIMEOUT=120
DASHSCOPE_MAX_RETRIES=3
# Maximum number of times the grader is allowed to send the question back to
# the rewrite node before generation is forced. 0 disables rewrites entirely.
MAX_REWRITES=2
# Bound only the transcript projection sent to chat LLM calls. The complete
# thread remains available through the history API.
CHAT_CONTEXT_MAX_TURNS=8
CHAT_CONTEXT_MAX_CHARS=12000
# Optional bounded planning, dependency-aware sub-goal execution, and answer
# critique/revision. Disabled by default to preserve existing latency/behavior.
PLANNING_ENABLED=false
PLANNING_MAX_SUBGOALS=4
PLANNING_MAX_REFLECTION_RETRIES=1
PLANNING_CRITIC_THRESHOLD=0.7
# Per-URL timeout (seconds) when fetching source pages. Unreachable hosts are
# skipped after this many seconds instead of hanging the indexing run.
PAGE_LOAD_TIMEOUT=15
# Maximum number of source URLs fetched in parallel during indexing.
PAGE_LOAD_MAX_CONCURRENCY=4
# In-process source document cache TTL in seconds. 0 disables caching.
PAGE_LOAD_CACHE_TTL_SECONDS=0
# Conservative pre-index document filtering. The relevance query is optional;
# leave it empty for configured source URLs unless you intentionally want
# keyword-overlap filtering before splitting and embedding.
DOCUMENT_QUALITY_FILTER_ENABLED=true
DOCUMENT_QUALITY_MIN_TEXT_LENGTH=80
DOCUMENT_QUALITY_MIN_UNIQUE_TERMS=8
DOCUMENT_QUALITY_RELEVANCE_QUERY=
DOCUMENT_QUALITY_QUERY_MIN_OVERLAP=1
DOCUMENT_QUALITY_MIN_SIMILARITY=0.5
DOCUMENT_QUALITY_RECENCY_BIAS_DAYS=365
# Post-retrieval reranking strategy: lexical (default), embedding, or hybrid.
RERANK_STRATEGY=lexical
# Optional: override if your DashScope account/network uses another endpoint
DASHSCOPE_HTTP_BASE_URL=

# Local Chroma vector database path
CHROMA_DIR=.chroma
COLLECTION_NAME=rag-chroma

# Source URLs, comma-separated. Leave empty to use DEFAULT_URLS from src/config.py.
SOURCE_URLS=

# Web search for automatic source discovery when no URLs are provided
WEB_SEARCH_ENABLED=true
# Optional compatibility mode. Keep false to avoid an extra LLM call per search.
WEB_SEARCH_LLM_QUERY_REWRITE_ENABLED=false
# Search provider fallback: bing, baidu, duckduckgo, serper, brave, tavily,
# or bing_api. WEB_SEARCH_PROVIDERS is an optional comma-separated priority
# list. Configured API providers are automatically preferred for Mandarin.
WEB_SEARCH_PROVIDER=bing
WEB_SEARCH_PROVIDERS=
WEB_SEARCH_PROVIDER_FANOUT=2
# Key-backed search APIs avoid CAPTCHA-prone HTML scraping. Configure one or
# more; each service may provide a free quota and may charge beyond it.
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
BING_SEARCH_API_KEY=
BING_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/search
WEB_SEARCH_MAX_RESULTS=20
# Network timeout for each provider request and deadline for the overall
# provider-discovery phase, both in seconds.
WEB_SEARCH_PROVIDER_TIMEOUT_SECONDS=8
WEB_SEARCH_API_TIMEOUT_SECONDS=20
WEB_SEARCH_DEADLINE_SECONDS=30
# Of the URLs returned by the search engine, how many of the top-ranked
# results to actually fetch and index. Lowering this keeps the answer focused
# on the most relevant pages and speeds up indexing. Set to 0 to fetch all.
WEB_SEARCH_TOP_K=6
# Minimum URL quality score before a search result is considered usable.
WEB_SEARCH_MIN_URL_SCORE=45
WEB_SEARCH_REGION=wt-wt
# For Bing, the default wt-wt is treated as zh-CN.
# Optional DuckDuckGo timelimit: d, w, m, or y
WEB_SEARCH_TIMELIMIT=
# Set false only if your local certificate store blocks HTTPS verification
WEB_SEARCH_VERIFY_SSL=true
# Use lightweight fetch -> extract -> direct prompt path for one-shot web search URLs.
# Set false to preserve the heavy Chroma retrieval/rewrite path for web search.
WEB_SEARCH_LIGHTWEIGHT=true
# Per-page token budget for lightweight web-search context.
WEB_SEARCH_MAX_PAGE_TOKENS=8000
# Minimum extracted content required before a web page is treated as readable.
WEB_SEARCH_MIN_PAGE_CHARS=200
WEB_SEARCH_MIN_PAGE_TOKENS=50
# Optional browser-backed fetch fallback for JS-rendered pages.
# Requires installing Playwright and running: python -m playwright install chromium
WEB_SEARCH_JS_FALLBACK_ENABLED=true
WEB_SEARCH_JS_FALLBACK_DOMAINS=baike.baidu.com,zhuanlan.zhihu.com,apps.microsoft.com,deepseek.net
WEB_SEARCH_JS_FORCE_DOMAINS=
# The JS retry now fires whenever an HTTP fetch produced no readable text or a
# login/enable-JavaScript shell. Domains above only get priority when the budget
# cannot cover every candidate page.
WEB_SEARCH_JS_RETRY_BUDGET=2
# Dynamic structural page filtering: measures link density and content volume on
# the fetched page instead of guessing from the URL. Removes index/tag listings,
# login walls, and thin shells that no denylist can enumerate.
WEB_SEARCH_STRUCTURE_FILTER_ENABLED=true
WEB_SEARCH_MAX_LINK_DENSITY=0.5
WEB_SEARCH_MIN_CONTENT_WORDS=60
# Optional semantic relevance layered on the lexical gates. It can only add
# recall (paraphrases, cross-language snippets), never reject. Loads a local
# sentence-transformers model on first use, so it is off by default.
WEB_SEARCH_SEMANTIC_FILTER_ENABLED=false
WEB_SEARCH_SEMANTIC_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
WEB_SEARCH_SEMANTIC_MIN_SIMILARITY=0.35
# Adaptive per-domain reputation learned from fetch outcomes, stored under
# CHROMA_DIR/web-search/reputation.sqlite3. Ranking prior only, never a rejection.
WEB_SEARCH_DOMAIN_REPUTATION_ENABLED=true
WEB_SEARCH_DOMAIN_REPUTATION_MIN_SAMPLES=5

# Optional agent tools. Every flag in this section defaults to false in code
# (src/config/settings.py), so a deployment that never sets them keeps the
# original retriever + web-search tool set. The values below are the
# fully-enabled configuration: flip any to false to trim what the agent can
# call. retrieve_source_documents is always registered, not flag-controlled.
WEATHER_ENABLED=true
STOCK_ENABLED=true
CURRENCY_ENABLED=true
WIKIPEDIA_ENABLED=true
# AMap-backed directions and map tools. The Web Service key stays server-side.
# The JS API key is browser-visible; its security code stays server-side and is
# injected by the bounded same-origin /_AMapService proxy.
AMAP_WEB_SERVICE_KEY=your_amap_web_service_key_here
AMAP_JS_API_KEY=your_amap_js_api_key_here
AMAP_JS_SECURITY_CODE=your_amap_js_security_code_here
AMAP_API_TIMEOUT_SECONDS=10
DIRECTIONS_ENABLED=true
MAP_ENABLED=true
# Symbolic math tool (SymPy: derivatives, integrals, solve, simplify, limits, series). No API key.
MATH_ENABLED=true
# Descriptive statistics, linear algebra, and number theory tools. No API key.
STATISTICS_ENABLED=true
LINALG_ENABLED=true
NUMBER_THEORY_ENABLED=true
# Date/time math + timezone conversion tool (stdlib). No API key.
DATETIME_ENABLED=true
# Single-URL fetch + summarize tool (reuses web-search fetcher + the LLM). No API key.
SUMMARIZE_URL_ENABLED=true
# Local file-reading tools (.txt/.md/.log/.csv, Word .docx, Excel .xlsx, PDF .pdf,
# .json/.jsonl, .r/.rs/.go/.sql, .zip archives).
# Reads are confined to FILE_READ_ROOT and capped at FILE_READ_MAX_BYTES.
# Sensitive files (.env, keys, credentials) are always refused.
FILE_READ_ENABLED=true
FILE_READ_ROOT=.
FILE_READ_MAX_BYTES=5000000
# Document editors. Each needs FILE_READ_ENABLED, and each tool is only offered
# inside a chat session that has an upload directory: a sessionless or QA graph
# exposes none of them regardless of these flags. Writes never overwrite the
# uploaded source.
# Word .docx creation and editing.
WORD_EDIT_ENABLED=false
POWERPOINT_EDIT_ENABLED=false
# Excel .xlsx creation. Needs FILE_READ_ENABLED and @oai/artifact-tool in the
# configured loader-provided Node dependency directory.
EXCEL_CREATE_ENABLED=false
EXCEL_NODE_EXECUTABLE=node
EXCEL_NODE_MODULES_PATH=
# Excel .xlsx editing. Needs FILE_READ_ENABLED too. openpyxl-based; writes a
# session-scoped copy and never overwrites the uploaded source.
EXCEL_EDIT_ENABLED=false
# Plain-text .txt creation and editing. Needs FILE_READ_ENABLED too. Writes are
# confined to the current chat session and never overwrite an existing file.
TEXT_EDIT_ENABLED=false
# Markdown .md creation and editing. Needs FILE_READ_ENABLED too. Same
# session-scoped, never-overwrite model as the .txt editor.
MARKDOWN_EDIT_ENABLED=false
# CSV .csv creation and editing. Needs FILE_READ_ENABLED too. Standard-library
# csv quoting; same session-scoped, never-overwrite model as the .txt editor.
CSV_EDIT_ENABLED=false
# TypeScript .ts/.tsx creation and editing. Needs FILE_READ_ENABLED too. Same
# session-scoped, never-overwrite model as the .txt editor.
TYPESCRIPT_EDIT_ENABLED=false
# JSON .json creation and structured path-based editing. Needs
# FILE_READ_ENABLED too; session-scoped, never overwrites an existing file.
JSON_EDIT_ENABLED=false
# JSONL .jsonl creation and editing; every written line must parse as JSON.
# Needs FILE_READ_ENABLED too; same session-scoped never-overwrite model.
JSONL_EDIT_ENABLED=false
# R / Rust / Go / SQL / PHP / Ruby / LaTeX source creation and editing.
# Needs FILE_READ_ENABLED too; same session-scoped, never-overwrite model as
# the .txt editor.
R_EDIT_ENABLED=false
RUST_EDIT_ENABLED=false
GO_EDIT_ENABLED=false
SQL_EDIT_ENABLED=false
PHP_EDIT_ENABLED=false
RUBY_EDIT_ENABLED=false
LATEX_EDIT_ENABLED=false
PROLOG_EDIT_ENABLED=false
HASKELL_EDIT_ENABLED=false
LUA_EDIT_ENABLED=false
JULIA_EDIT_ENABLED=false
SHELL_EDIT_ENABLED=false
MATLAB_EDIT_ENABLED=false
GROOVY_EDIT_ENABLED=false
SWIFT_EDIT_ENABLED=false
LOG_EDIT_ENABLED=false
# Chat-agent long-term memory (save_memory / recall_memory / forget_memory).
# Off by default; when off, no memory file is read or created.
MEMORY_ENABLED=false
# Blank means memory/long_term_memory.json relative to the working directory.
# The store file is git-ignored. A ".." path segment is refused.
MEMORY_STORE_PATH=
# Total records kept across all scopes (1-10000). The oldest by last-recall
# time are evicted first once the cap is reached.
MEMORY_MAX_RECORDS=500
# Maximum characters of one remembered item (1-10000).
MEMORY_MAX_RECORD_CHARS=1000
# Records returned per recall (1-50).
MEMORY_RECALL_TOP_K=5
# Character cap on memory text injected into the prompt (1-20000).
MEMORY_CONTEXT_MAX_CHARS=2000
# Default scope for a saved memory: global (all sessions) or session (this
# conversation only, deleted with the session).
MEMORY_DEFAULT_SCOPE=global
# Prepend relevant memories to each chat turn automatically. When false the
# tools stay callable but nothing is injected.
MEMORY_AUTO_RECALL_ENABLED=true
# Automatic memory extraction (self-updating memory). When enabled the agent
# distils durable facts from a finished session and from every completed round
# of MEMORY_EXTRACTION_TURN_INTERVAL turns, without being asked. Costs one extra
# LLM call per extraction. Off by default.
MEMORY_EXTRACTION_ENABLED=false
# Also extract from the previous session when a new session starts.
MEMORY_EXTRACTION_ON_SESSION_START=true
# Turns per extraction round (1-1000).
MEMORY_EXTRACTION_TURN_INTERVAL=10
# Maximum memories accepted from one extraction (1-20).
MEMORY_EXTRACTION_MAX_CANDIDATES=5
# Character cap on the transcript excerpt sent to one extraction (200-100000).
MEMORY_EXTRACTION_MAX_TRANSCRIPT_CHARS=8000
# Seconds to wait for the extraction LLM call before abandoning it (1-600).
MEMORY_EXTRACTION_TIMEOUT_SECONDS=60
# Extractions allowed to run at once (1-16). Extra requests are dropped, not queued.
MEMORY_EXTRACTION_MAX_CONCURRENCY=2
# Skip session-start extraction for sessions idle longer than this (1-8760 hours).
MEMORY_EXTRACTION_MAX_SESSION_AGE_HOURS=168
WIKIPEDIA_MAX_SUMMARY_CHARS=1500
# Use a deployment-specific contact string for Wikimedia API etiquette.
WIKIPEDIA_USER_AGENT="langgraph-rag/1.0 (contact: configure WIKIPEDIA_USER_AGENT)"
