# Secrets and local config
.env

# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.coverage
.coverage.*
.hypothesis/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Logs and local install output
*.log
install_log.txt

# Vector database
.chroma/

# Benchmark run outputs (queries.json and docs stay tracked)
benchmarks/**/runs.jsonl
benchmarks/**/judgments.jsonl
benchmarks/**/runs/

# Chat agent long-term memory store (runtime state, recreated on demand)
memory/

# User-uploaded chat files (runtime artifacts)
chat_uploads/

# Jupyter scratch
.ipynb_checkpoints/

# Editor / IDE state
.idea/
.vscode/
.kilo/

# Generated artifacts
graph.png
# Unquoted "pkg>=X" in a Bash command: ">" is a redirect, so the shell creates a
# file literally named "=X" in the cwd. Never meaningful, so ignore everywhere.
=*

# Local project notes
COMPANY_READINESS_GAPS.md
CHANGELOG.md
PROBLEMS_DETECTED.md
SSL_FIX.md
MEMORY.md
docs/code-review-web-search.md
docs/rag-operations/edit_docx_plan.txt
docs/claude_code_CLI_history.txt
collect.txt

# Local skill notes at any directory depth
SKILL.md
# ...except the tracked web-search provider registry doc
!src/backend/web_search/SKILL.md

# Local agent scratch (keep .claude/agents/ tracked)
.claude/*
!.claude/agents/

# Workbench scratch
advanced_phase1_workbench/
advanced_phase2_interfaces_workbench/

# OS noise
.DS_Store
Thumbs.db

